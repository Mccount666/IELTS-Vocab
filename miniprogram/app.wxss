page {
  min-height: 100vh;
  background: #f7fbfb;
  color: #14212b;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.container {
  padding: 28rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(19, 78, 74, 0.08);
  border: 1rpx solid rgba(15, 118, 110, 0.08);
}

.section-title {
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #14212b;
}

.muted {
  color: #6b7a86;
  font-size: 26rpx;
  line-height: 1.6;
}

.primary-btn,
.secondary-btn,
.danger-btn {
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 2.6;
  margin: 0;
}

.primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #0f766e, #14b8a6);
}

.secondary-btn {
  color: #0f766e;
  background: #e6fffb;
}

.danger-btn {
  color: #b42318;
  background: #fff1f0;
}

.input,
.textarea,
.picker-like {
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #eef7f6;
  color: #14212b;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
}

.textarea {
  min-height: 300rpx;
  line-height: 1.55;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #eef7f6;
  color: #44606a;
  font-size: 24rpx;
}

.chip.active {
  background: #0f766e;
  color: #ffffff;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.word {
  font-size: 44rpx;
  font-weight: 800;
  color: #0f3f3c;
}

mark,
.highlight {
  color: #0f766e;
  background: #d9fbf4;
  border-radius: 8rpx;
  padding: 0 6rpx;
}
