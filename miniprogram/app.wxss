page {
  min-height: 100vh;
  background: #f2fbf8;
  color: #1f3d44;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.container {
  padding: 28rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(13, 148, 136, 0.10);
  border: 1rpx solid rgba(13, 148, 136, 0.12);
}

.section-title {
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #1f3d44;
}

.muted {
  color: #7d949e;
  font-size: 26rpx;
  line-height: 1.6;
}

.primary-btn,
.secondary-btn,
.danger-btn {
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 2.6;
  margin: 0;
  /* 原生 button 自带约 184px 的 min-width（UA 级样式），普通覆盖无效，
     必须 !important 才能压住，否则小尺寸按钮/网格轨道被撑破 */
  min-width: 0 !important;
}

.primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #14b8a6, #2dd4bf);
}

.secondary-btn {
  color: #0d9488;
  background: #e6fffb;
}

.danger-btn {
  color: #b42318;
  background: #fff1f0;
}

.input,
.textarea,
.picker-like {
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #eafcf6;
  color: #1f3d44;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
}

/* 原生 input 的纵向 padding 不生效，高度会塌成一行文字（实测 22px），
   显式给高度并垂直居中，保证与 picker-like 等控件视觉一致 */
.input {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
}

.input[password] {
  letter-spacing: 2rpx;
}

.textarea {
  min-height: 300rpx;
  line-height: 1.55;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #eafcf6;
  color: #567882;
  font-size: 24rpx;
}

.chip.active {
  background: #0d9488;
  color: #ffffff;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.word {
  font-size: 44rpx;
  font-weight: 800;
  color: #0e5148;
}

mark,
.highlight {
  color: #0d9488;
  background: #c9faf0;
  border-radius: 8rpx;
  padding: 0 6rpx;
}

/* ---- view 自绘按钮：原生 button 有 184px 隐形 min-width（UA 级，CSS 不可覆盖），
   网格/小尺寸场景一律用 .btn 体系 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.2;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
  transition: opacity 0.15s ease;
}

.btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #14b8a6, #2dd4bf);
}

.btn.secondary {
  color: #0d9488;
  background: #eafcf6;
}

.btn.danger {
  color: #b42318;
  background: #fff1f0;
}

.btn-hover {
  opacity: 0.65;
}
