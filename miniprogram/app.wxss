page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a2129 0%, #1d242c 50%, #22282f 100%);
  color: #dbe3e8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
}

.section-title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #eef2f4;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  border-radius: 999rpx;
  background: #2dd4bf;
  flex-shrink: 0;
}

.muted {
  color: #8b98a1;
  font-size: 25rpx;
  line-height: 1.6;
}

.primary-btn,
.secondary-btn,
.danger-btn {
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 2.6;
  margin: 0;
  font-weight: 600;
  /* 原生 button 自带约 184px 的 min-width（UA 级样式），普通覆盖无效，
     必须 !important 才能压住，否则小尺寸按钮/网格轨道被撑破 */
  min-width: 0 !important;
}

.primary-btn {
  color: #06332c;
  background: linear-gradient(135deg, #3ee6c4, #17b9a4);
  box-shadow: 0 8rpx 24rpx rgba(45, 212, 191, 0.25);
}

.primary-btn::after,
.secondary-btn::after,
.danger-btn::after {
  border: none;
}

.secondary-btn {
  color: #4fe3c1;
  background: rgba(45, 212, 191, 0.10);
}

.danger-btn {
  color: #ff9d94;
  background: rgba(255, 107, 97, 0.10);
}

.input,
.textarea,
.picker-like {
  width: 100%;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  color: #e8eef1;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
}

/* 原生 input 的纵向 padding 不生效，高度会塌成一行文字（实测 22px），
   显式给高度并垂直居中，保证与 picker-like 等控件视觉一致 */
.input {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
}

.input[password] {
  letter-spacing: 2rpx;
}

.textarea {
  min-height: 300rpx;
  line-height: 1.55;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  color: #9fb0b8;
  font-size: 24rpx;
}

.chip.active {
  background: linear-gradient(135deg, #3ee6c4, #17b9a4);
  color: #06332c;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(45, 212, 191, 0.22);
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.word {
  font-size: 42rpx;
  font-weight: 600;
  color: #f0f7f5;
}

mark,
.highlight {
  color: #58e6c9;
  background: rgba(45, 212, 191, 0.16);
  border-radius: 8rpx;
  padding: 0 6rpx;
}

/* ---- view 自绘按钮：原生 button 有 184px 隐形 min-width（UA 级，CSS 不可覆盖），
   网格/小尺寸场景一律用 .btn 体系 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.2;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
  font-weight: 600;
  transition: opacity 0.15s ease;
}

.btn.primary {
  color: #06332c;
  background: linear-gradient(135deg, #3ee6c4, #17b9a4);
  box-shadow: 0 8rpx 24rpx rgba(45, 212, 191, 0.25);
}

.btn.secondary {
  color: #4fe3c1;
  background: rgba(45, 212, 191, 0.10);
}

.btn.danger {
  color: #ff9d94;
  background: rgba(255, 107, 97, 0.10);
}

.btn-hover {
  opacity: 0.65;
}
