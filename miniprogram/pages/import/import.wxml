<view class="container stack">
  <view class="card stack">
    <view class="section-title">文件导入</view>

    <view class="file-pick-row">
      <view class="btn secondary pick-btn" hover-class="btn-hover" bindtap="chooseFile">选择文件</view>
      <view class="btn secondary pick-btn" hover-class="btn-hover" bindtap="chooseImage">选择图片</view>
    </view>

    <view class="stack" wx:if="{{files.length}}">
      <view class="section-title" style="font-size: 30rpx;">已选 {{files.length}} 个文件</view>
      <view class="file-item" wx:for="{{files}}" wx:key="path">
        <view class="file-info">
          <view class="file-name">{{item.name}}</view>
          <view class="muted">{{item.sizeText}}</view>
        </view>
        <view class="file-remove" data-index="{{index}}" bindtap="removeFile" wx:if="{{fileState === 'idle'}}">移除</view>
      </view>

      <view class="stack">
        <view class="muted">来源名称</view>
        <input class="input" placeholder="例如 Cambridge 18 Test 1 阅读" value="{{docName}}" bindinput="onDocNameInput" disabled="{{fileState !== 'idle'}}" />
        <picker mode="selector" range="{{examTypes}}" range-key="label" value="{{fileExamIndex}}" bindchange="onFileExamChange" disabled="{{fileState !== 'idle'}}">
          <view class="picker-like">考试类型：{{examTypes[fileExamIndex].label}}</view>
        </picker>
      </view>

      <button class="primary-btn" wx:if="{{fileState === 'idle'}}" bindtap="startFileImport">转换并导入</button>

      <view class="progress-box" wx:if="{{fileState !== 'idle' && fileState !== 'error'}}">
        <view class="progress-text">{{fileProgress}}</view>
        <view class="progress-track"><view class="progress-dot"></view></view>
      </view>

      <view class="error-box" wx:if="{{fileState === 'error'}}">
        <view>{{fileProgress}}</view>
        <button class="secondary-btn retry-btn" bindtap="resetFileState">重试</button>
      </view>
    </view>
  </view>

  <view class="card stack">
    <view class="section-title">粘贴文本</view>

    <input class="input" placeholder="文档名称，例如 Cambridge 18 Test 1" value="{{filename}}" bindinput="onFilenameInput" />

    <picker mode="selector" range="{{examTypes}}" range-key="label" value="{{examIndex}}" bindchange="onExamChange">
      <view class="picker-like">考试类型：{{examTypes[examIndex].label}}</view>
    </picker>

    <textarea class="textarea" maxlength="-1" placeholder="把阅读/听力原文粘贴到这里" value="{{text}}" bindinput="onTextInput" />

    <view class="between muted">
      <text>{{sentenceCount}} 句</text>
      <text>{{tokenCount}} 个索引词</text>
    </view>

    <button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">建立索引</button>
  </view>

  <view class="card stack" wx:if="{{documents.length}}">
    <view class="section-title">已导入文档</view>
    <view class="doc" wx:for="{{documents}}" wx:key="_id">
      <view class="doc-main">
        <view class="doc-name">{{item.filename}}</view>
        <view class="doc-meta">
          <view class="doc-exam">{{item.examTypeLabel}}</view>
          <view class="muted">{{item.sentenceCount || 0}} 句</view>
        </view>
      </view>
      <view class="btn danger doc-delete" hover-class="btn-hover" data-id="{{item._id}}" bindtap="deleteDoc">删除</view>
    </view>
  </view>
</view>
