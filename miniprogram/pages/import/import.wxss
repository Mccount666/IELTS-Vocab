.file-pick-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.pick-btn {
  font-size: 26rpx;
  padding: 18rpx 0;
}

.file-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.file-info {
  min-width: 0;
}

.file-name {
  font-size: 27rpx;
  color: #dbe3e8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-remove {
  color: #ff9d94;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 107, 97, 0.10);
  border-radius: 999rpx;
}

.progress-box {
  padding: 24rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(45, 212, 191, 0.06);
}

.progress-text {
  color: #aebbc2;
  font-size: 26rpx;
  text-align: center;
}

.progress-track {
  margin-top: 18rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
  position: relative;
}

.progress-dot {
  position: absolute;
  left: -60rpx;
  width: 60rpx;
  height: 6rpx;
  background: #2dd4bf;
  border-radius: 999rpx;
  animation: slide 1.4s linear infinite;
}

@keyframes slide {
  0% { left: -60rpx; }
  100% { left: 100%; }
}

.error-box {
  padding: 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 107, 97, 0.10);
  border: 1rpx solid rgba(255, 107, 97, 0.28);
  color: #ff9d94;
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-all;
}

.retry-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
}

.doc {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.doc-main {
  min-width: 0;
  flex: 1;
}

.doc-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
}

.doc-exam {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #4fe3c1;
  background: rgba(45, 212, 191, 0.12);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

.doc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #eef2f4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.doc-delete {
  width: 128rpx;
  font-size: 24rpx;
  padding: 14rpx 0;
}
