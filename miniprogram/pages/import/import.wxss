.file-pick-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.pick-btn {
  font-size: 26rpx;
  padding: 18rpx 0;
}

.file-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f8fdfb;
  border: 1rpx solid #e2f3ee;
}

.file-info {
  min-width: 0;
}

.file-name {
  font-size: 27rpx;
  color: #27454e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-remove {
  color: #b42318;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: #fff1f0;
  border-radius: 999rpx;
}

.progress-box {
  padding: 24rpx 20rpx;
  border-radius: 18rpx;
  background: #f0fbf7;
}

.progress-text {
  color: #3f6570;
  font-size: 26rpx;
  text-align: center;
}

.progress-track {
  margin-top: 18rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #d5f1e8;
  overflow: hidden;
  position: relative;
}

.progress-dot {
  position: absolute;
  left: -60rpx;
  width: 60rpx;
  height: 6rpx;
  background: #0d9488;
  border-radius: 999rpx;
  animation: slide 1.4s linear infinite;
}

@keyframes slide {
  0% { left: -60rpx; }
  100% { left: 100%; }
}

.error-box {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
  color: #b42318;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

.retry-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
}

.doc {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx 22rpx;
  border-radius: 20rpx;
  background: #f8fdfb;
  border: 1rpx solid #e2f3ee;
}

.doc-main {
  min-width: 0;
  flex: 1;
}

.doc-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
}

.doc-exam {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #0f766e;
  background: #d9f6ee;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

.doc-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f3d44;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.doc-delete {
  width: 128rpx;
  font-size: 24rpx;
  padding: 14rpx 0;
}
