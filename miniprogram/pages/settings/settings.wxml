<view class="container stack">
  <view class="card stack">
    <view class="between">
      <view class="section-title">我的</view>
      <view class="role-badge {{user.isAdmin ? 'admin' : ''}}">{{user.isAdmin ? '站长' : '普通用户'}}</view>
    </view>
  </view>

  <view class="card stack">
    <view class="section-title">AI 释义与翻译</view>

    <picker mode="selector" range="{{protocols}}" range-key="label" value="{{protocolIndex}}" bindchange="onProtocolChange">
      <view class="picker-like">接口协议：{{protocols[protocolIndex].label}}</view>
    </picker>

    <input class="input" placeholder="https://api.deepseek.com/v1" value="{{form.llmBaseUrl}}" bindinput="onInput" data-field="llmBaseUrl" />
    <input class="input" password placeholder="API Key，留空不修改" value="{{form.llmApiKey}}" bindinput="onInput" data-field="llmApiKey" />
    <view class="model-row">
      <picker class="model-picker" mode="selector" range="{{modelOptions}}" value="{{modelIndex < 0 ? 0 : modelIndex}}" bindchange="onModelChange" disabled="{{!modelOptions.length}}">
        <view class="picker-like">模型：{{form.llmModel || '请先拉取模型列表'}}</view>
      </picker>
      <view class="small-btn {{loadingModels ? 'disabled' : ''}}" bindtap="loadModels">{{loadingModels ? '拉取中' : '拉取模型'}}</view>
    </view>
    <view class="test-row">
      <view class="small-btn ghost {{testing ? 'disabled' : ''}}" bindtap="testConnection">{{testing ? '测试中' : '测试连接'}}</view>
      <view class="muted test-status">{{testStatus}}</view>
    </view>

    <view class="link-block stack">
      <view class="muted">申请 Key：</view>
      <view class="link-row">
        <view class="link-chip" data-url="https://cloud.siliconflow.cn/account/ak" bindtap="copyLink">硅基流动</view>
        <view class="link-chip" data-url="https://platform.deepseek.com/api_keys" bindtap="copyLink">DeepSeek</view>
        <view class="link-chip" data-url="https://bigmodel.cn/codingplan" bindtap="copyLink">智谱 GLM</view>
      </view>
      <view class="link-row">
        <view class="link-chip" data-url="https://www.kimi.com/codingplan" bindtap="copyLink">Kimi</view>
        <view class="link-chip" data-url="https://bailian.console.aliyun.com/coding-plan" bindtap="copyLink">通义千问</view>
      </view>
    </view>

    <view class="muted">LLM Key：{{settings.llmKeySet ? '已设置' : '未设置'}}</view>
    <button class="primary-btn" loading="{{saving}}" bindtap="save">保存设置</button>
  </view>

  <view class="card stack">
    <view class="section-title">MinerU 文件识别</view>

    <input class="input" password placeholder="MinerU Token，留空不修改" value="{{form.mineruApiToken}}" bindinput="onInput" data-field="mineruApiToken" />

    <view class="link-block stack">
      <view class="muted">申请 Token：</view>
      <view class="link-row">
        <view class="link-chip" data-url="https://mineru.net" bindtap="copyLink">mineru.net</view>
      </view>
    </view>

    <view class="muted">MinerU：{{settings.mineruTokenSet ? '已设置' : '未设置'}}</view>
  </view>
</view>
