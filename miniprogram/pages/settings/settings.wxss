.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  color: #304b55;
  font-size: 28rpx;
  border-bottom: 1rpx solid #edf3f4;
}

.role-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #eef7f6;
  color: #6b7a86;
  font-size: 24rpx;
}

.role-badge.admin {
  background: #0f766e;
  color: #ffffff;
}

.protocol-desc {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f1f8f8;
  font-size: 24rpx;
}

.link-block {
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background: #f8fcfc;
  border: 1rpx solid #e3efee;
}

.link-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.link-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #0f766e;
  color: #0f766e;
  font-size: 24rpx;
}

.link-chip:active {
  background: #0f766e;
  color: #ffffff;
}
