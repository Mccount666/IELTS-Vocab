.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  color: #3f6570;
  font-size: 28rpx;
  border-bottom: 1rpx solid #e5f2ef;
}

.role-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #eafcf6;
  color: #7d949e;
  font-size: 24rpx;
}

.role-badge.admin {
  background: #0d9488;
  color: #ffffff;
}

.protocol-desc {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f0fbf7;
  font-size: 24rpx;
}

.link-block {
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background: #f6fdfb;
  border: 1rpx solid #ddf2ec;
}

.link-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.link-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #0d9488;
  color: #0d9488;
  font-size: 24rpx;
}

.link-chip:active {
  background: #0d9488;
  color: #ffffff;
}
