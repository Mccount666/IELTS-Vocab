.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  color: #3f6570;
  font-size: 28rpx;
  border-bottom: 1rpx solid #eef6f3;
}

.info-row:last-child {
  border-bottom: 0;
}

.role-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #eafcf6;
  color: #7d949e;
  font-size: 24rpx;
}

.role-badge.admin {
  background: #0d9488;
  color: #ffffff;
}

.protocol-desc {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f0fbf7;
  font-size: 24rpx;
}

.link-block {
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background: #f6fdfb;
  border: 1rpx solid #ddf2ec;
}

.link-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.link-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #0d9488;
  color: #0d9488;
  font-size: 24rpx;
}

.link-chip:active {
  background: #0d9488;
  color: #ffffff;
}

.model-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.model-picker {
  flex: 1;
  min-width: 0;
}

.small-btn {
  flex: 0 0 auto;
  padding: 0 26rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #14b8a6, #0d9488);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(13, 148, 136, 0.25);
}

.small-btn.disabled {
  opacity: 0.55;
}
