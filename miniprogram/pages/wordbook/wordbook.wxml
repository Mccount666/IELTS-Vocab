<view class="container stack">
  <view class="card stack">
    <view class="between">
      <view>
        <view class="section-title">生词本</view>
        <view class="muted">{{words.length}} 个收藏</view>
      </view>
    </view>
  </view>

  <view class="stack" wx:if="{{words.length}}">
    <view class="word-card card" wx:for="{{words}}" wx:key="_id">
      <view class="between">
        <view class="word-main">
          <view class="word">{{item.word}}</view>
          <view class="muted" wx:if="{{item.phonetic}}">{{item.phonetic}}</view>
        </view>
        <button class="danger-btn delete-btn" data-id="{{item._id}}" bindtap="deleteWord">删除</button>
      </view>
      <view class="definition" wx:if="{{item.translation || item.definition}}">{{item.translation || item.definition}}</view>
      <view class="muted added-row" wx:if="{{item.addedDate}}">收藏于 {{item.addedDate}}</view>
    </view>
  </view>

  <view class="card empty" wx:else>
    <view class="section-title">还没有生词</view>
    <view class="muted">在查词页把单词或例句收录进来。</view>
  </view>
</view>
