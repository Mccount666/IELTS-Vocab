.word-card {
  padding: 28rpx;
}

.word-main {
  min-width: 0;
}

.phon-chip {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #0f766e;
  background: #d9f6ee;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}

.delete-btn {
  width: 128rpx;
  font-size: 24rpx;
  padding: 14rpx 0;
  flex-shrink: 0;
}

.definition {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #f6fdfb;
  border: 1rpx solid #e2f3ee;
  color: #27454e;
  font-size: 28rpx;
  line-height: 1.65;
}

.added-row {
  margin-top: 12rpx;
  font-size: 23rpx;
}

.empty {
  text-align: center;
}

.go-search {
  margin: 24rpx auto 0;
  width: 240rpx;
  padding: 18rpx 0;
}
