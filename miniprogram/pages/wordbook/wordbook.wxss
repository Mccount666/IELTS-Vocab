.wb-head {
  padding: 0 6rpx;
}

.word-card {
  padding: 28rpx;
}

.word-main {
  min-width: 0;
}

.phon-chip {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #4fe3c1;
  background: rgba(45, 212, 191, 0.12);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}

.delete-btn {
  width: 128rpx;
  font-size: 24rpx;
  padding: 14rpx 0;
  flex-shrink: 0;
}

.definition {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  color: #dfe7eb;
  font-size: 28rpx;
  line-height: 1.65;
}

.empty {
  text-align: center;
}

.go-search {
  margin: 24rpx auto 0;
  width: 240rpx;
  padding: 18rpx 0;
}
