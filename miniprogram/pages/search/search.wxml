<view class="container stack">
  <view class="card stack search-card">
    <view class="section-title">查一个单词</view>
    <view class="search-row">
      <input class="input search-input" placeholder="例如 environment" value="{{word}}" confirm-type="search" bindinput="onWordInput" bindconfirm="submit" />
      <button class="primary-btn search-btn" bindtap="submit" loading="{{loading}}">查</button>
    </view>
    <picker mode="selector" range="{{examTypes}}" range-key="label" value="{{examIndex}}" bindchange="onExamChange">
      <view class="picker-like">范围：{{examTypes[examIndex].label}}</view>
    </picker>
    <view class="chip-row" wx:if="{{suggestions.length}}">
      <view class="chip" wx:for="{{suggestions}}" wx:key="word" data-word="{{item.word}}" bindtap="pickSuggestion">{{item.word}} · {{item.count}}</view>
    </view>
  </view>

  <view class="card stack" wx:if="{{result.word}}">
    <view class="between">
      <view>
        <view class="word">{{result.word}}</view>
        <view class="muted">lemma: {{result.lemma}}</view>
      </view>
      <button class="secondary-btn collect-btn" bindtap="collectWord">{{result.wordbookEntry ? '已收录' : '收录'}}</button>
    </view>
  </view>

  <view class="stack" wx:if="{{sentences.length}}">
    <view class="sentence card" wx:for="{{sentences}}" wx:key="_id">
      <view class="sentence-text">{{item.text}}</view>
      <view class="between muted meta-row">
        <text>位置 {{item.position + 1}}</text>
        <button class="secondary-btn mini" data-id="{{item._id}}" bindtap="collectSentence">收录例句</button>
      </view>
    </view>
  </view>

  <view class="card empty" wx:elif="{{searched && !loading}}">
    <view class="section-title">还没有例句</view>
    <view class="muted">请先在“导入”页粘贴真题文本，再回来查词。</view>
  </view>
</view>
