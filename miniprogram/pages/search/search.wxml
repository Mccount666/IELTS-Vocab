<view class="container stack">
  <view class="card stack search-card">
    <view class="search-row">
      <input class="input search-input" maxlength="80" placeholder="输入单词或短语" value="{{word}}" confirm-type="search" bindinput="onWordInput" bindconfirm="submit" />
      <view class="btn primary search-btn" hover-class="btn-hover" bindtap="submit">查词</view>
    </view>
    <picker mode="selector" range="{{examTypes}}" range-key="label" value="{{examIndex}}" bindchange="onExamChange">
      <view class="picker-like">范围：{{examTypes[examIndex].label}}</view>
    </picker>
    <view class="chip-row" wx:if="{{suggestions.length}}">
      <view class="chip" wx:for="{{suggestions}}" wx:key="word" data-word="{{item.word}}" bindtap="pickSuggestion">{{item.word}} · {{item.count}}</view>
    </view>
  </view>

  <view class="card stack" wx:if="{{history.length && !result.word}}">
    <view class="between">
      <view class="section-title" style="font-size: 30rpx;">最近查询</view>
      <view class="muted clear-btn" bindtap="clearHistory">清空</view>
    </view>
    <view class="chip-row">
      <view class="chip" wx:for="{{history}}" wx:key="*this" data-word="{{item}}" bindtap="pickHistory">{{item}}</view>
    </view>
  </view>

  <view class="card stack" wx:if="{{result.word}}">
    <view class="between">
      <view class="word-main">
        <view class="word">{{result.word}}</view>
        <view class="muted" wx:if="{{result.lemma}}">词形：{{result.lemma}}</view>
      </view>
      <view class="btn secondary collect-btn" hover-class="btn-hover" bindtap="collectWord">{{result.wordbookEntry ? '已收录' : '收录'}}</view>
    </view>

    <view class="dict-box stack" wx:if="{{dict}}">
      <view class="between">
        <view class="dict-source">{{dict.source || '词典'}}</view>
        <view class="chip ai-chip" hover-class="chip-hover" bindtap="aiDefine">✨ AI 解释</view>
      </view>
      <view wx:if="{{dict.phonetic}}" class="phonetic">{{dict.phonetic}}</view>
      <view wx:if="{{dict.translation}}" class="dict-translation">{{dict.translation}}</view>
      <view wx:if="{{dict.definition}}" class="muted">{{dict.definition}}</view>
      <view class="stack example-stack" wx:if="{{dict.examples.length}}">
        <view class="example" wx:for="{{dict.examples}}" wx:key="en" wx:for-item="ex">
          <view>{{ex.en}}</view>
          <view class="muted" wx:if="{{ex.zh}}">{{ex.zh}}</view>
        </view>
      </view>
    </view>
    <view class="muted center" wx:elif="{{dictLoading}}">释义加载中…</view>
    <view class="muted center" wx:elif="{{!dictLoading && !dict}}">暂无词典结果</view>

    <view class="dict-box ai-box stack" wx:if="{{aiDict}}">
      <view class="between">
        <view class="ai-source">✨ AI 解释</view>
      </view>
      <view wx:if="{{aiDict.phonetic}}" class="phonetic">{{aiDict.phonetic}}</view>
      <view wx:if="{{aiDict.translation}}" class="dict-translation">{{aiDict.translation}}</view>
      <view wx:if="{{aiDict.definition}}" class="muted">{{aiDict.definition}}</view>
      <view class="stack example-stack" wx:if="{{aiDict.examples.length}}">
        <view class="example" wx:for="{{aiDict.examples}}" wx:key="en" wx:for-item="ex">
          <view>{{ex.en}}</view>
          <view class="muted" wx:if="{{ex.zh}}">{{ex.zh}}</view>
        </view>
      </view>
    </view>
    <view class="muted center" wx:elif="{{aiLoading}}">AI 解释生成中…</view>
    <view class="btn secondary ai-fallback" hover-class="btn-hover" wx:if="{{!aiDict && !aiLoading && !dict && !dictLoading}}" bindtap="aiDefine">✨ AI 解释</view>
  </view>

  <view class="stack" wx:if="{{sentenceViews.length}}">
    <view class="sentence card" wx:for="{{sentenceViews}}" wx:key="_id">
      <view class="sentence-text"><text wx:for="{{item.parts}}" wx:for-item="seg" wx:key="index"><text class="{{seg.hl ? 'hl' : ''}}">{{seg.t}}</text></text></view>
      <view class="translation" wx:if="{{translations[item._id] && translations[item._id] !== '…'}}">{{translations[item._id]}}</view>
      <view class="muted" wx:elif="{{translations[item._id] === '…'}}">翻译中…</view>
      <view class="between muted meta-row">
        <text class="source">{{item.sourceLabel}}</text>
        <view class="row mini-row">
          <view class="btn secondary mini" hover-class="btn-hover" data-id="{{item._id}}" data-text="{{item.text}}" bindtap="translateSentence">翻译</view>
          <view class="btn secondary mini" hover-class="btn-hover" data-id="{{item._id}}" bindtap="collectSentence">收录</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card empty" wx:elif="{{searched && !loading}}">
    <view class="section-title">还没有例句</view>
    <view class="muted">先在「导入」页添加真题文本。</view>
    <view class="stack" wx:if="{{nearWords.length}}" style="margin-top: 24rpx; text-align: left;">
      <view class="muted">真题里的相近词：</view>
      <view class="chip-row" style="margin-top: 14rpx;">
        <view class="chip" wx:for="{{nearWords}}" wx:key="word" data-word="{{item.word}}" bindtap="pickSuggestion">{{item.word}}</view>
      </view>
    </view>
  </view>
</view>
