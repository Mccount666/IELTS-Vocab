.search-row {
  display: grid;
  grid-template-columns: 1fr 132rpx;
  gap: 16rpx;
  align-items: center;
}

.search-btn {
  width: 100%;
  padding: 20rpx 0;
}

.collect-btn {
  width: 156rpx;
  font-size: 25rpx;
  padding: 18rpx 0;
}

.sentence-text {
  font-size: 31rpx;
  line-height: 1.75;
  color: #27454e;
}

.meta-row {
  margin-top: 20rpx;
  white-space: nowrap;
}

.mini {
  width: 136rpx;
  font-size: 24rpx;
  padding: 14rpx 0;
}

.empty {
  text-align: center;
}

.dict-box {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #f0fbf7;
  border: 1rpx solid rgba(13, 148, 136, 0.10);
}

.dict-source {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #0d9488;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  align-self: flex-start;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 380rpx;
}

.ai-chip {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #92610e;
  font-weight: 600;
  flex-shrink: 0;
}

.chip-hover {
  opacity: 0.7;
}

.ai-box {
  background: linear-gradient(160deg, #fffbeb, #fef3c7);
  border: 1rpx solid rgba(217, 160, 32, 0.22);
}

.ai-source {
  font-size: 26rpx;
  font-weight: 700;
  color: #92610e;
}

.ai-hint {
  font-size: 22rpx;
  flex-shrink: 0;
}

.ai-box .phonetic {
  color: #b45309;
}

.ai-box .example {
  background: rgba(255, 255, 255, 0.75);
}

.phonetic {
  color: #0d9488;
  font-size: 28rpx;
  margin-top: 6rpx;
}

.dict-translation {
  font-size: 30rpx;
  line-height: 1.7;
  color: #27454e;
  margin-top: 10rpx;
}

.example-stack {
  margin-top: 16rpx;
}

.example {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border-left: 6rpx solid #99e9d9;
  font-size: 28rpx;
  line-height: 1.6;
  color: #27454e;
}

.translation {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f0fbf7;
  color: #3f6570;
  font-size: 27rpx;
  line-height: 1.65;
}

.mini-row {
  gap: 12rpx;
  flex-shrink: 0;
}

.hl {
  color: #0d9488;
  background: #c9faf0;
  border-radius: 8rpx;
  padding: 0 6rpx;
  font-weight: 700;
}

.source {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.clear-btn {
  padding: 6rpx 18rpx;
  background: #f0fbf7;
  border-radius: 999rpx;
}

.word-main {
  min-width: 0;
}

.center {
  text-align: center;
}

.ai-fallback {
  margin: 8rpx auto 0;
  width: 240rpx;
  padding: 16rpx 0;
}
