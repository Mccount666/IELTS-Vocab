.search-row {
  display: grid;
  grid-template-columns: 1fr 132rpx;
  gap: 16rpx;
  align-items: center;
}

.search-btn {
  width: 100%;
  padding: 20rpx 0;
}

.collect-btn {
  width: 156rpx;
  font-size: 25rpx;
  padding: 18rpx 0;
}

.sentence-text {
  font-size: 31rpx;
  line-height: 1.75;
  color: #dfe7eb;
}

.meta-row {
  margin-top: 20rpx;
  white-space: nowrap;
}

.mini {
  width: 136rpx;
  font-size: 24rpx;
  padding: 14rpx 0;
}

.empty {
  text-align: center;
}

.dict-box {
  padding: 26rpx;
  border-radius: 20rpx;
  background: rgba(45, 212, 191, 0.06);
  border: 1rpx solid rgba(45, 212, 191, 0.14);
}

.dict-source {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #4fe3c1;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  align-self: flex-start;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 380rpx;
}

.ai-chip {
  background: rgba(251, 191, 36, 0.14);
  color: #fcd34d;
  font-weight: 600;
  flex-shrink: 0;
}

.chip-hover {
  opacity: 0.7;
}

.ai-box {
  background: rgba(251, 191, 36, 0.06);
  border: 1rpx solid rgba(251, 191, 36, 0.18);
}

.ai-source {
  font-size: 26rpx;
  font-weight: 600;
  color: #fcd34d;
}

.ai-box .phonetic {
  color: #fcd34d;
}

.ai-box .example {
  background: rgba(255, 255, 255, 0.05);
}

.phonetic {
  color: #4fe3c1;
  font-size: 28rpx;
  margin-top: 6rpx;
}

.dict-translation {
  font-size: 30rpx;
  line-height: 1.7;
  color: #e6edf0;
  margin-top: 10rpx;
}

.example-stack {
  margin-top: 16rpx;
}

.example {
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  border-left: 4rpx solid #2dd4bf;
  font-size: 28rpx;
  line-height: 1.6;
  color: #dfe7eb;
}

.translation {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  color: #aebbc2;
  font-size: 27rpx;
  line-height: 1.65;
}

.mini-row {
  gap: 12rpx;
  flex-shrink: 0;
}

.hl {
  color: #58e6c9;
  background: rgba(45, 212, 191, 0.16);
  border-radius: 8rpx;
  padding: 0 6rpx;
  font-weight: 600;
}

.source {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.clear-btn {
  padding: 6rpx 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 999rpx;
}

.word-main {
  min-width: 0;
}

.center {
  text-align: center;
}

.ai-fallback {
  margin: 8rpx auto 0;
  width: 240rpx;
  padding: 16rpx 0;
}
