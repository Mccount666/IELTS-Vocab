.search-row {
  display: grid;
  grid-template-columns: 1fr 132rpx;
  gap: 16rpx;
  align-items: center;
}

.search-btn {
  width: 100%;
  padding: 20rpx 0;
}

.collect-btn {
  width: 156rpx;
  font-size: 25rpx;
  padding: 18rpx 0;
}

.sentence-text {
  font-size: 31rpx;
  line-height: 1.75;
  color: #27454e;
}

.meta-row {
  margin-top: 20rpx;
  white-space: nowrap;
}

.mini {
  width: 136rpx;
  font-size: 24rpx;
  padding: 14rpx 0;
}

.empty {
  text-align: center;
}

.dict-box {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f0fbf7;
}

.phonetic {
  color: #0d9488;
  font-size: 28rpx;
  margin-top: 6rpx;
}

.dict-translation {
  font-size: 30rpx;
  line-height: 1.7;
  color: #27454e;
  margin-top: 10rpx;
}

.example-stack {
  margin-top: 16rpx;
}

.example {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 1.6;
  color: #27454e;
}

.translation {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f0fbf7;
  color: #3f6570;
  font-size: 27rpx;
  line-height: 1.65;
}

.mini-row {
  gap: 12rpx;
  flex-shrink: 0;
}

.hl {
  color: #0d9488;
  background: #c9faf0;
  border-radius: 8rpx;
  padding: 0 6rpx;
  font-weight: 700;
}

.source {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.clear-btn {
  padding: 6rpx 18rpx;
  background: #f0fbf7;
  border-radius: 999rpx;
}

.word-main {
  min-width: 0;
}

.center {
  text-align: center;
}
