<view class="home-wrap">
  <view class="glow glow-teal"></view>
  <view class="glow glow-warm"></view>

  <view class="container stack">
    <view class="error-box" wx:if="{{error}}">{{error}}</view>
    <view class="hero">
      <view class="hero-eyebrow">IELTS VOCAB</view>
      <view class="hero-title">从你的真题里
查单词</view>
      <view class="hero-actions">
        <view class="btn primary" hover-class="btn-hover" bindtap="goSearch">开始查词</view>
        <view class="btn glass" hover-class="btn-hover" bindtap="goImport">导入文本</view>
      </view>
    </view>

    <view class="stats-grid">
      <view class="stat glass">
        <view class="stat-value">{{docCount}}</view>
        <view class="stat-label">真题文档</view>
      </view>
      <view class="stat glass">
        <view class="stat-value">{{wordCount}}</view>
        <view class="stat-label">收藏生词</view>
      </view>
    </view>
  </view>
</view>
