.home-wrap {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 纯 WXSS 氛围光效：顶部青绿冷光 + 底部暖琥珀光 */
.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(90rpx);
  pointer-events: none;
}

.glow-teal {
  top: -140rpx;
  right: -120rpx;
  width: 480rpx;
  height: 480rpx;
  background: rgba(45, 212, 191, 0.16);
}

.glow-warm {
  bottom: -180rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 640rpx;
  height: 420rpx;
  background: rgba(217, 164, 96, 0.14);
}

.container {
  position: relative;
}

.error-box {
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 107, 97, 0.10);
  border: 1rpx solid rgba(255, 107, 97, 0.28);
  color: #ff9d94;
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-all;
}

.hero {
  padding: 96rpx 12rpx 48rpx;
}

.hero-eyebrow {
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: #6f7f8a;
  font-weight: 600;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 60rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #f2f5f7;
  white-space: pre-line;
}

.hero-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 56rpx;
}

.glass {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.22);
}

.btn.glass {
  color: #dbe3e8;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.stat {
  text-align: center;
  padding: 32rpx 12rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #3ee6c4;
}

.stat-label {
  margin-top: 8rpx;
  color: #8b98a1;
  font-size: 23rpx;
}
