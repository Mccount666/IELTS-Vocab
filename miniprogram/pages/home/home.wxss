.error-box {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
  color: #b42318;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

.hero {
  background: linear-gradient(145deg, #eafff7, #ffffff 58%, #ecf5ff);
}

.hero-kicker {
  color: #0d9488;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 54rpx;
  line-height: 1.15;
  font-weight: 900;
  color: #0e5148;
}

.hero-desc {
  margin-top: 18rpx;
  color: #6b8590;
  font-size: 29rpx;
  line-height: 1.7;
}

.hero-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.stat {
  text-align: center;
  padding: 24rpx 12rpx;
}

.stat-value {
  font-size: 42rpx;
  font-weight: 900;
  color: #0d9488;
}

.stat-label {
  margin-top: 6rpx;
  color: #7d949e;
  font-size: 23rpx;
}

.step {
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f0fbf7;
  color: #3f6570;
  font-size: 28rpx;
}
