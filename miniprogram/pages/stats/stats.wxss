.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.stat-box {
  border-radius: 24rpx;
  padding: 28rpx 18rpx;
  background: #eef7f6;
  text-align: center;
}

.stat-value {
  color: #0f766e;
  font-size: 48rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 8rpx;
  color: #6b7a86;
  font-size: 25rpx;
}

.chart {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 220rpx;
  padding-top: 24rpx;
}

.bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
}

.bar {
  width: 100%;
  min-height: 6rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: linear-gradient(180deg, #14b8a6, #0f766e);
}

.bar-label {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #8aa0a8;
  transform: scale(0.85);
}
