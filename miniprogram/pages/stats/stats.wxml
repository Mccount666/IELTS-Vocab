<view class="container stack">
  <view class="card stack">
    <view>
      <view class="section-title">学习统计</view>
      <view class="muted">按本地日期统计复习记录，避免晚间复习跨日。</view>
    </view>

    <view class="stats-grid">
      <view class="stat-box">
        <view class="stat-value">{{stats.wordCount}}</view>
        <view class="stat-label">生词总数</view>
      </view>
      <view class="stat-box">
        <view class="stat-value">{{stats.dueCount}}</view>
        <view class="stat-label">今日待复习</view>
      </view>
      <view class="stat-box">
        <view class="stat-value">{{stats.todayReviews}}</view>
        <view class="stat-label">今日已复习</view>
      </view>
      <view class="stat-box">
        <view class="stat-value">{{stats.totalReviews}}</view>
        <view class="stat-label">累计复习</view>
      </view>
    </view>
  </view>

  <view class="card stack">
    <view class="section-title">最近 30 天</view>
    <view class="chart">
      <view class="bar-wrap" wx:for="{{bars}}" wx:key="date">
        <view class="bar" style="height: {{item.height}}rpx;"></view>
        <view class="bar-label">{{item.day}}</view>
      </view>
    </view>
  </view>
</view>
